# ==============================================================================
# DISASTERRADAR.AI / FLOODRISK AI - GLOBAL GEOSPATIAL & ML ENVIRONMENT CONFIG
# ==============================================================================
# Fill in your API tokens below. Free-tier registration links provided for each service.
# For college/non-commercial research, all services have free tiers (₹0 API cost).

# ------------------------------------------------------------------------------
# 1. OPEN-METEO WEATHER API (Rainfall 24h, 72h, Precipitation Accumulation)
# ------------------------------------------------------------------------------
# Free tier allows up to 10,000 requests/day globally with NO API key required.
# If you have an Open-Meteo commercial key, enter it below; otherwise leave blank.
# Docs: https://open-meteo.com/en/docs
OPEN_METEO_API_KEY=
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_ARCHIVE_URL=https://archive-api.open-meteo.com/v1/archive

# ------------------------------------------------------------------------------
# 2. COPERNICUS DATA SPACE ECOSYSTEM / SENTINEL HUB (Sentinel-2, Copernicus DEM)
# ------------------------------------------------------------------------------
# Used for:
# - Copernicus 30m/90m Global DEM -> Elevation, Slope, and Topographic Wetness Index (TWI)
# - Sentinel-2 MSI Bands (Red, Green, NIR) -> Real-time NDVI and NDWI calculations
# Register free: https://dataspace.copernicus.eu/
# Sentinel Hub Dashboard: https://shapps.dataspace.copernicus.eu/dashboard/
COPERNICUS_CLIENT_ID=your_copernicus_client_id_here
COPERNICUS_CLIENT_SECRET=your_copernicus_client_secret_here
COPERNICUS_INSTANCE_ID=your_sentinel_hub_instance_id_here
COPERNICUS_TOKEN_URL=https://identity.dataspace.copernicus.eu/auth/realms/CDSE/protocol/openid-connect/token
SENTINEL_HUB_PROCESS_URL=https://sh.dataspace.copernicus.eu/api/v1/process

# ------------------------------------------------------------------------------
# 3. GOOGLE EARTH ENGINE & DYNAMIC WORLD (Urbanization, Land Cover, Built Index)
# ------------------------------------------------------------------------------
# Used for:
# - Dynamic World 10m Land Cover -> "Built" probability % to calculate Urbanization Index (1-10)
# - MODIS 250m 16-day Composite NDVI as fallback
# Free non-commercial registration: https://earthengine.google.com/signup/
GEE_PROJECT_ID=your_gcp_project_id_here
GEE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GEE_PRIVATE_KEY_PATH=
# Optional: Raw JSON service account key string if not using key file
GEE_SERVICE_ACCOUNT_JSON=

# ------------------------------------------------------------------------------
# 4. OPENSTREETMAP & OVERPASS API (Drainage, Infrastructure & Vulnerability Proxies)
# ------------------------------------------------------------------------------
# Used to calculate:
# - Drainage Capacity: Storm drains, culverts, waterways, canal density
# - Infrastructure Vulnerability: Road network density, building footprints, aging barriers
# - Disaster Preparedness: Proximity to emergency services, hospitals, fire stations
# Public Overpass is free under ODbL with user-agent attribution.
OSM_OVERPASS_URL=https://overpass-api.de/api/interpreter
OSM_USER_AGENT=DisasterRadar-FloodRiskAI/1.0 (flood-intelligence-research)

# ------------------------------------------------------------------------------
# 5. MAPBOX / BASEMAP TILES (Optional High-Resolution Satellite Visuals)
# ------------------------------------------------------------------------------
# Free tier provides 50,000 map loads/month for interactive satellite & terrain layers.
# Get token: https://account.mapbox.com/
MAPBOX_ACCESS_TOKEN=your_mapbox_public_token_here

# ------------------------------------------------------------------------------
# 6. APPLICATION & DATABASE ENGINE SETTINGS
# ------------------------------------------------------------------------------
APP_ENV=development
APP_PORT=8000
APP_HOST=127.0.0.1
DEBUG=True
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# SQLite Database for historical disasters and prediction audit logs
DATABASE_URL=sqlite:///./backend/disaster_history.db
DB_WAL_MODE=True

# Machine Learning Model Configuration
XGB_MODEL_PATH=models/flood_model.json
METRICS_PATH=models/metrics.json
DECISION_THRESHOLD=0.55
